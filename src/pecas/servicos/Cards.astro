---
// Tratamentos em cards, agrupados por categoria. Cada grupo abre com uma capa (foto em
// recorte orgânico + nome da categoria). O card inteiro é clicável e abre o WhatsApp.
import Foto from '../comum/Foto.astro';
import Icone from '../comum/Icone.astro';
import { fmt, preco } from '../../lib/texto.js';

const { site } = Astro.props;
const t = site.textos.servicos;
const capas = site.fotos.categorias ?? [];
const FORMAS = [
  '58% 42% 50% 50% / 46% 52% 48% 54%',
  '44% 56% 60% 40% / 56% 44% 56% 44%',
  '52% 48% 40% 60% / 42% 58% 44% 56%',
];
---

<section class="cd secao" id="tratamentos">
  <div class="container">
    <div class="cd__topo">
      <p class="sobrelinha" data-revelar>{t.sobrelinha}</p>
      <h2 class="titulo titulo--2 cd__titulo" data-revelar style="--atraso:100ms" set:html={fmt(t.titulo)} />
      <p class="texto cd__texto" data-revelar style="--atraso:180ms">{t.texto}</p>
    </div>

    {
      site.servicos.map((grupo, gi) => (
        <div class="cd__grupo">
          <div class="cd__capa" data-revelar>
            {capas[gi] && (
              <Foto
                class="cd__capa-foto"
                foto={capas[gi]}
                forma="organica"
                sizes="(min-width: 900px) 28vw, 40vw"
              />
            )}
            <div class="cd__capa-texto">
              <h3 class="cd__categoria" set:html={fmt(grupo.categoria)} />
              <p>
                {grupo.itens.length} {t.tratamentos}
              </p>
            </div>
          </div>

          <ul class="cd__lista">
            {grupo.itens.map((item, i) => {
              const p = preco(item);
              return (
                <li data-revelar style={`--atraso:${(i % 2) * 90}ms`}>
                  <a class="card" href={site.links.servico(item.nome)} target="_blank" rel="noopener">
                    {item.duracao && <span class="card__duracao">{item.duracao}</span>}
                    <span class="card__nome">{item.nome}</span>
                    <span class="card__desc">{item.descricao}</span>
                    {item.indicado && (
                      <span class="card__indicado">
                        <strong>{t.indicado}:</strong> {item.indicado}
                      </span>
                    )}
                    <span class="card__rodape">
                      <span class="card__preco">
                        {p.aPartirDe && <small>{t.aPartirDe}</small>}
                        {p.valor}
                      </span>
                      <span class="card__ir" aria-hidden="true">
                        <Icone nome="seta" />
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style define:vars={{ forma0: FORMAS[0], forma1: FORMAS[1], forma2: FORMAS[2] }}>
  .cd__topo {
    max-width: 640px;
  }

  .cd__titulo {
    margin-top: 16px;
  }

  .cd__texto {
    margin-top: 20px;
  }

  .cd__grupo {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--colunas-gap);
    margin-top: clamp(64px, 8vw, 112px);
  }

  .cd__capa {
    grid-column: 1 / span 4;
    align-self: start;
    position: sticky;
    top: calc(var(--altura-cab) + 32px);
  }

  .cd__grupo:nth-child(3n + 2) .cd__capa-foto {
    --forma-organica: var(--forma0);
  }

  .cd__grupo:nth-child(3n + 3) .cd__capa-foto {
    --forma-organica: var(--forma1);
  }

  .cd__grupo:nth-child(3n + 4) .cd__capa-foto {
    --forma-organica: var(--forma2);
  }

  .cd__capa-foto {
    width: 86%;
    aspect-ratio: 1;
  }

  .cd__capa-texto {
    margin-top: 24px;
  }

  .cd__categoria {
    font-family: var(--fonte-titulo);
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-style: italic;
    font-weight: 330;
    line-height: 1.05;
  }

  .cd__capa-texto p {
    margin-top: 6px;
    font-size: 15px;
    color: var(--tinta-suave);
  }

  .cd__lista {
    grid-column: 5 / -1;
    align-self: start;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 26px 26px 22px;
    border-radius: 24px;
    background: var(--fundo-alt);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.35s;
  }

  .card__duracao {
    align-self: flex-start;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--fundo);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--tinta-suave);
  }

  .card__nome {
    margin-top: 18px;
    font-family: var(--fonte-titulo);
    font-size: 1.55rem;
    font-weight: 380;
    line-height: 1.15;
  }

  .card__desc {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--tinta-suave);
  }

  .card__indicado {
    margin-top: 12px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  .card__indicado strong {
    font-weight: 600;
    color: var(--tinta);
  }

  .card__rodape {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 22px;
  }

  .card__preco {
    display: flex;
    flex-direction: column;
    font-family: var(--fonte-titulo);
    font-size: 1.4rem;
    line-height: 1.1;
  }

  .card__preco small {
    font-family: var(--fonte-texto);
    font-size: 12px;
    color: var(--tinta-suave);
  }

  .card__ir {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--tinta);
    color: var(--fundo);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-4px);
      background: color-mix(in srgb, var(--fundo-alt) 86%, var(--destaque));
    }

    .card:hover .card__ir {
      transform: rotate(-45deg);
    }
  }

  @media (max-width: 1023px) {
    .cd__lista {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 899px) {
    .cd__grupo {
      display: block;
      margin-top: 64px;
    }

    .cd__capa {
      position: static;
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 24px;
    }

    .cd__capa-foto {
      flex: none;
      width: 104px;
    }

    .cd__capa-texto {
      margin-top: 0;
    }

    .cd__lista {
      gap: 12px;
    }

    .card {
      padding: 22px 22px 18px;
    }
  }
</style>
