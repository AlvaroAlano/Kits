---
// Galeria em arcada: uma fileira de arcos lado a lado, com alturas alternadas, sobre uma linha
// de "chão". No celular a fileira desliza para o lado.
import Foto from '../comum/Foto.astro';
import { fmt } from '../../lib/texto.js';

const { site } = Astro.props;
const t = site.textos.galeria;
const fotos = site.fotos.galeria.slice(0, 6);
---

<section class="ar secao" id="espaco">
  <div class="container ar__topo">
    <div>
      <p class="sobrelinha" data-revelar>{t.sobrelinha}</p>
      <h2 class="titulo titulo--2 ar__titulo" data-revelar style="--atraso:100ms" set:html={fmt(t.titulo)} />
    </div>
    {t.texto && <p class="texto" data-revelar style="--atraso:180ms">{t.texto}</p>}
  </div>

  <div class="container ar__moldura">
    <ul class="ar__fileira" data-revelar style="--atraso:200ms">
      {
        fotos.map((foto, i) => (
          <li class:list={['ar__arco', i % 2 === 1 && 'ar__arco--baixo']}>
            <Foto class="ar__foto" foto={foto} forma="arco" sizes="(min-width: 900px) 20vw, 60vw" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ar__topo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 64px;
  }

  .ar__titulo {
    margin-top: 18px;
  }

  .ar__topo > .texto {
    max-width: 38ch;
  }

  .ar__fileira {
    display: flex;
    align-items: flex-end;
    gap: clamp(10px, 1.4vw, 20px);
    margin-top: clamp(48px, 6vw, 80px);
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--tinta);
  }

  .ar__arco {
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 3 / 5;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .ar__arco--baixo {
    aspect-ratio: 3 / 4.2;
  }

  .ar__foto {
    width: 100%;
    height: 100%;
  }

  @media (hover: hover) {
    .ar__arco:hover {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 899px) {
    .ar__moldura {
      padding-inline: 0;
    }

    .ar__fileira {
      gap: 10px;
      margin-top: 40px;
      margin-inline: var(--margem);
      padding-bottom: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .ar__fileira::-webkit-scrollbar {
      display: none;
    }

    .ar__arco {
      flex: none;
      width: 46vw;
      scroll-snap-align: start;
    }
  }
</style>
