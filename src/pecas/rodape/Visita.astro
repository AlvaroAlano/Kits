---
// Rodapé claro que também é a seção de contato: endereço com rotas, horários e contato.
import Marca from '../comum/Marca.astro';
import Icone from '../comum/Icone.astro';

const { site } = Astro.props;
const { cliente, links, ano, textos } = site;
const { endereco, contato, profissional, horarios = [] } = cliente;
const t = textos.rodape;
---

<footer class="rv" id="contato">
  <div class="container">
    <div class="rv__grade">
      <div class="rv__marca">
        <Marca site={site} />
        <p class="rv__frase">{t.frase}</p>
      </div>
      <div>
        <h3>{t.endereco}</h3>
        <p>
          {endereco.linha1}<br />
          {endereco.bairro} · {endereco.cidade}/{endereco.uf}<br />
          CEP {endereco.cep}
        </p>
        <p class="rv__rotas">
          <a href={links.maps} target="_blank" rel="noopener"><Icone nome="mapa" /> {t.maps}</a>
          <a href={links.waze} target="_blank" rel="noopener"><Icone nome="navegar" /> {t.waze}</a>
        </p>
      </div>
      <div>
        <h3>{t.horarios}</h3>
        <p>{horarios.map((h, i) => <Fragment>{i > 0 && <br />}{h}</Fragment>)}</p>
      </div>
      <div>
        <h3>{t.contato}</h3>
        <p>
          <a class="rv__link" href={links.whats} target="_blank" rel="noopener">{contato.whatsappExibicao}</a>
          {
            links.instagram && (
              <Fragment>
                <br />
                <a class="rv__link" href={links.instagram} target="_blank" rel="noopener">@{contato.instagram}</a>
              </Fragment>
            )
          }
        </p>
      </div>
    </div>

    <div class="rv__base">
      <p>© {ano} {cliente.nome} · Responsável técnica: {profissional.nome} · {profissional.registro}</p>    </div>
  </div>
</footer>

<style>
  .rv {
    padding-block: clamp(64px, 8vw, 104px) calc(28px + env(safe-area-inset-bottom));
  }

  .rv__grade {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px var(--colunas-gap);
  }

  .rv__marca {
    --marca-tamanho: 1.6rem;
  }

  .rv__marca :global(.marca) {
    align-items: flex-start;
  }

  .rv__grade .rv__frase {
    max-width: 18ch;
    margin-top: 18px;
    font-family: var(--fonte-assinatura);
    font-size: 1.5rem;
    line-height: 1.15;
    color: var(--destaque);
  }

  .rv h3 {
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .rv__grade p {
    font-size: 15.5px;
    line-height: 1.7;
  }

  .rv__rotas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 12px;
  }

  .rv__rotas a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--destaque);
  }

  .rv__rotas :global(svg) {
    width: 16px;
    height: 16px;
  }

  .rv__link {
    border-bottom: 1.5px solid var(--linha-forte);
  }

  .rv__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--linha);
    font-size: 13px;
    color: var(--tinta-suave);
  }

  @media (max-width: 1023px) {
    .rv__grade {
      grid-template-columns: 1fr 1fr;
    }

    .rv__marca {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 599px) {
    .rv__grade {
      grid-template-columns: 1fr;
    }

    /* espaço para o botão flutuante */
    .rv__base {
      padding-bottom: 72px;
    }
  }
</style>
