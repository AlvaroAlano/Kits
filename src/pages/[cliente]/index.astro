---
// Página que vai para a cliente na call: um link só, com todos os estilos preparados para ela.
import { clientes, estilosDoCliente, montarSite } from '../../lib/site.js';
import { comBase } from '../../lib/texto.js';

export function getStaticPaths() {
  return clientes.map((cliente) => ({ params: { cliente: cliente.slug }, props: { cliente } }));
}

const { cliente } = Astro.props;
const propostas = estilosDoCliente(cliente).map((id) => montarSite(cliente, id));
const miniatura = (src) => (src.includes('images.unsplash.com') ? `${src}?auto=format&fit=crop&q=70&w=720&h=900` : comBase(src));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Propostas de site · {cliente.nome}</title>
  </head>
  <body>
    <main class="hub">
      <header class="hub__topo">
        <p class="hub__de">Convcard · propostas de site</p>
        <h1>Olá, {cliente.profissional.nome.split(' ')[0]}.</h1>
        <p class="hub__texto">
          {propostas.length === 1
            ? 'Preparamos uma proposta de site com a sua marca. Abra no celular para ver como suas clientes vão ver.'
            : `Preparamos ${propostas.length} propostas de site com a sua marca. Abra cada uma no celular e veja qual tem mais a sua cara.`}
        </p>
      </header>

      <ol class="hub__lista">
        {
          propostas.map((site, i) => (
            <li>
              <a class="proposta" href={comBase(`/${cliente.slug}/${site.estilo.id}/`)}>
                <img src={miniatura(site.fotos.hero.src)} alt="" loading="lazy" />
                <span class="proposta__cores" aria-hidden="true">
                  {['fundo', 'fundoAlt', 'destaque', 'escuro'].map((c) => (
                    <i style={`background:${site.paleta[c]}`} />
                  ))}
                </span>
                <span class="proposta__num">Proposta {String(i + 1).padStart(2, '0')}</span>
                <span class="proposta__nome">{site.estilo.nome}</span>
                <span class="proposta__desc">{site.estilo.descricao}</span>
                <span class="proposta__ver">Ver proposta →</span>
              </a>
            </li>
          ))
        }
      </ol>
    </main>

    <style is:global>
      body {
        margin: 0;
        background: #f4f2ee;
        color: #1c1a18;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
    </style>

    <style>
      .hub {
        max-width: 1200px;
        margin: 0 auto;
        padding: clamp(40px, 8vw, 96px) 20px 80px;
      }

      .hub__de {
        margin: 0;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #6f6a64;
      }

      h1 {
        margin: 16px 0 0;
        font-size: clamp(2.2rem, 5vw, 3.5rem);
        font-weight: 500;
        letter-spacing: -0.02em;
      }

      .hub__texto {
        max-width: 52ch;
        margin: 14px 0 0;
        font-size: 17px;
        line-height: 1.6;
        color: #4f4a45;
      }

      .hub__lista {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin: 48px 0 0;
        padding: 0;
        list-style: none;
      }

      .proposta {
        display: grid;
        gap: 8px;
        color: inherit;
        text-decoration: none;
      }

      .proposta img {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        transition: opacity 0.3s;
      }

      .proposta:hover img {
        opacity: 0.88;
      }

      .proposta__cores {
        display: flex;
        margin-top: 6px;
      }

      .proposta__cores i {
        width: 22px;
        height: 22px;
        border: 1px solid rgb(0 0 0 / 0.08);
        margin-right: -1px;
      }

      .proposta__num {
        margin-top: 6px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #6f6a64;
      }

      .proposta__nome {
        font-size: 1.6rem;
        font-weight: 500;
        letter-spacing: -0.01em;
      }

      .proposta__desc {
        font-size: 15px;
        line-height: 1.55;
        color: #4f4a45;
      }

      .proposta__ver {
        margin-top: 4px;
        font-size: 14px;
        font-weight: 600;
      }
    </style>
  </body>
</html>
