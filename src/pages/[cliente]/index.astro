---
// Página que vai para a cliente na call: um link só, com todos os estilos preparados para ela.
// Cada proposta mostra uma miniatura desenhada do layout (cores e fonte do estilo), sem fotos.
import Amostra from '../../pecas/comum/Amostra.astro';
import { clientes, montarSite, ordemPropostas } from '../../lib/site.js';
import { comBase, semMarcas } from '../../lib/texto.js';

export function getStaticPaths() {
  return clientes.map((cliente) => ({ params: { cliente: cliente.slug }, props: { cliente } }));
}

const { cliente } = Astro.props;
const propostas = ordemPropostas(cliente).map((id) => montarSite(cliente, id));
const primeiroNome = cliente.profissional.nome.split(' ')[0];

// Uma requisição só ao Google Fonts, com apenas as letras usadas nas miniaturas (bem leve no celular)
const familias = [...new Set(propostas.flatMap((s) => s.estilo.amostra?.fontes ?? []))];
const letras = [
  ...new Set(
    propostas
      .flatMap((s) => [s.estilo.nome, semMarcas(s.textos.hero.titulo).replace(/\[\d\]/g, '')])
      .join('')
      .replace(/\s/g, ''),
  ),
].join('');
const urlFontes = familias.length
  ? `https://fonts.googleapis.com/css2?${familias.map((f) => `family=${f}`).join('&')}&text=${encodeURIComponent(letras)}&display=swap`
  : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3f1ed" />
    <title>Propostas de site · {cliente.nome}</title>
    {urlFontes && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {urlFontes && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {urlFontes && <link rel="stylesheet" href={urlFontes} />}
  </head>
  <body>
    <main class="hub">
      <header class="hub__topo">
        <p class="hub__rotulo">Propostas de site · {cliente.nome}</p>
        <h1>Olá, {primeiroNome}.</h1>
        <p class="hub__texto">
          {propostas.length === 1
            ? 'Preparamos uma proposta de site com a sua marca. Abra e veja como as suas clientes vão ver.'
            : `Preparamos ${propostas.length} propostas de site com a sua marca. Abra cada uma e toque no ♡ das que você mais gostar.`}
        </p>
        <p class="hub__favs" data-resumo hidden>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 4 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.7 1.1-1.6 2.7-2.7 4.7-2.7 3.3 0 5.7 3.1 4.5 6.6-1.7 4.8-9.2 9.4-9.2 9.4z" />
          </svg>
          <span data-resumo-texto></span>
        </p>
      </header>

      <ol class="hub__lista" data-cliente={cliente.slug}>
        {
          propostas.map((site, i) => (
            <li>
              <article
                class="proposta"
                data-proposta={site.estilo.id}
                data-nome={site.estilo.nome}
                style={`--p-fonte:${site.estilo.fontes.titulo};--p-cor:${site.paleta.tinta};--p-sobre:${site.paleta.fundo}`}
              >
                <span class="proposta__capa">
                  <button type="button" class="proposta__fav" aria-pressed="false" aria-label={`Favoritar ${site.estilo.nome}`} data-favoritar>
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke-width="1.8" aria-hidden="true">
                      <path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 4 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.7 1.1-1.6 2.7-2.7 4.7-2.7 3.3 0 5.7 3.1 4.5 6.6-1.7 4.8-9.2 9.4-9.2 9.4z" />
                    </svg>
                  </button>
                  <Amostra site={site} />
                  {site.recomendado && (
                    <span class="proposta__selo">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                        <path d="M12 2.8l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.6l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z" />
                      </svg>
                      Recomendado para você
                    </span>
                  )}
                </span>
                <span class="proposta__corpo">
                  <span class="proposta__num">Proposta {String(i + 1).padStart(2, '0')}</span>
                  <span class="proposta__nome">{site.estilo.nome}</span>
                  <span class="proposta__desc">{site.estilo.descricao}</span>
                  {site.estilo.amostra?.destaques && (
                    <span class="proposta__tags">
                      {site.estilo.amostra.destaques.map((d) => (
                        <span>{d}</span>
                      ))}
                    </span>
                  )}
                  <span class="proposta__espaco" />
                  <a class="proposta__ver" href={comBase(`/${cliente.slug}/${site.estilo.id}/`)}>
                    Ver proposta <span class="proposta__nome-oculto">{site.estilo.nome}</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 12h15M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </span>
              </article>
            </li>
          ))
        }
      </ol>

      <script>
        import { lerFavoritos, alternarFavorito } from '../../lib/favoritos.js';

        const lista = document.querySelector('[data-cliente]');
        const cliente = lista.dataset.cliente;
        const cartoes = [...lista.querySelectorAll('[data-proposta]')];
        const resumo = document.querySelector('[data-resumo]');
        const resumoTexto = document.querySelector('[data-resumo-texto]');

        const pintar = () => {
          const favoritos = lerFavoritos(cliente);
          const nomes = [];
          for (const cartao of cartoes) {
            const marcado = favoritos.includes(cartao.dataset.proposta);
            cartao.classList.toggle('proposta--favorita', marcado);
            const botao = cartao.querySelector('[data-favoritar]');
            botao.setAttribute('aria-pressed', String(marcado));
            botao.setAttribute('aria-label', `${marcado ? 'Desfavoritar' : 'Favoritar'} ${cartao.dataset.nome}`);
            if (marcado) nomes.push(cartao.dataset.nome);
          }
          resumo.hidden = nomes.length === 0;
          resumoTexto.textContent =
            nomes.length === 1 ? `Sua favorita: ${nomes[0]}` : `Suas favoritas: ${nomes.join(', ').replace(/, ([^,]*)$/, ' e $1')}`;
        };

        for (const cartao of cartoes) {
          const botao = cartao.querySelector('[data-favoritar]');
          botao.addEventListener('click', () => {
            alternarFavorito(cliente, cartao.dataset.proposta);
            pintar();
            botao.classList.remove('proposta__fav--pulso');
            void botao.offsetWidth;
            botao.classList.add('proposta__fav--pulso');
          });
        }

        pintar();
        // ao voltar de uma proposta pelo "voltar" do navegador, mostra o que ela marcou lá
        window.addEventListener('pageshow', pintar);
        window.addEventListener('storage', pintar);
      </script>

      <p class="hub__nota">
        Textos, fotos e preços são de exemplo. Depois da escolha, a gente ajusta tudo com você.
      </p>
    </main>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: #f3f1ed;
        color: #1c1a18;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: 100%;
      }
    </style>

    <style>
      .hub {
        max-width: 1180px;
        margin: 0 auto;
        padding: clamp(36px, 7vw, 88px) 16px calc(48px + env(safe-area-inset-bottom));
      }

      .hub__topo {
        padding-inline: 4px;
      }

      .hub__rotulo {
        margin: 0;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #7a746d;
      }

      h1 {
        margin: 14px 0 0;
        font-size: clamp(2.1rem, 7vw, 3.4rem);
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -0.03em;
      }

      .hub__texto {
        max-width: 46ch;
        margin: 12px 0 0;
        font-size: clamp(16px, 2.2vw, 18px);
        line-height: 1.55;
        color: #514b45;
      }

      .hub__lista {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
        gap: clamp(14px, 2vw, 24px);
        margin: clamp(28px, 5vw, 56px) 0 0;
        padding: 0;
        list-style: none;
      }

      .hub__lista li {
        display: flex;
      }

      .hub__favs {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 18px 0 0;
        padding: 9px 16px 9px 13px;
        border-radius: 999px;
        background: #fff;
        font-size: 14.5px;
        font-weight: 600;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
      }

      .hub__favs[hidden] {
        display: none;
      }

      .hub__favs svg {
        fill: #d9485f;
      }

      /* o cartão inteiro é clicável pelo link "Ver proposta" (que se estica sobre ele);
         o coração fica por cima e funciona separado */
      .proposta {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        padding: 10px;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
        transition:
          transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
          box-shadow 0.35s;
        -webkit-tap-highlight-color: transparent;
      }

      .proposta:has(.proposta__ver:active) {
        transform: scale(0.99);
      }

      @media (hover: hover) {
        .proposta:hover {
          transform: translateY(-4px);
          box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.35);
        }
      }

      .proposta.proposta--favorita {
        box-shadow: 0 0 0 2px #e8a3ae;
      }

      @media (hover: hover) {
        .proposta.proposta--favorita:hover {
          box-shadow:
            0 0 0 2px #e8a3ae,
            0 18px 40px -24px rgb(0 0 0 / 0.35);
        }
      }

      .proposta:has(.proposta__ver:focus-visible) {
        outline: 2px solid #1c1a18;
        outline-offset: 3px;
      }

      .proposta__capa {
        position: relative;
        display: block;
      }

      .proposta__fav {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 2;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: rgb(255 255 255 / 0.94);
        box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.45);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      .proposta__fav svg {
        fill: none;
        stroke: #d9485f;
        transition: fill 0.2s;
      }

      .proposta__fav[aria-pressed='true'] svg {
        fill: #d9485f;
      }

      .proposta__fav--pulso svg {
        animation: pulso 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
      }

      @keyframes pulso {
        40% {
          transform: scale(1.35);
        }
      }

      .proposta__nome-oculto {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .proposta__selo {
        position: absolute;
        top: 10px;
        left: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px 7px 10px;
        border-radius: 999px;
        background: #1c1a18;
        color: #fff;
        font-size: 12.5px;
        font-weight: 600;
        box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.5);
      }

      .proposta__selo svg {
        color: #f2c35b;
      }

      .proposta__corpo {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 18px 10px 8px;
      }

      .proposta__num {
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #8a837b;
      }

      .proposta__nome {
        margin-top: 6px;
        font-family: var(--p-fonte);
        font-size: 2rem;
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.01em;
      }

      .proposta__desc {
        margin-top: 10px;
        font-size: 15px;
        line-height: 1.55;
        color: #5a544d;
      }

      .proposta__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 14px;
      }

      .proposta__tags span {
        padding: 6px 11px;
        border-radius: 999px;
        background: #f3f1ed;
        font-size: 12.5px;
        font-weight: 500;
        color: #4a453f;
      }

      .proposta__ver {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 14px;
        background: var(--p-cor);
        color: var(--p-sobre);
        font-size: 15.5px;
        font-weight: 600;
        text-decoration: none;
      }

      .proposta__ver:focus-visible {
        outline: none;
      }

      .proposta__ver::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 22px;
      }

      /* o botão fica sempre embaixo; o espaço acima dele cresce quando um cartão tem menos texto */
      .proposta__espaco {
        flex: 1;
        min-height: 20px;
      }

      .hub__nota {
        max-width: 52ch;
        margin: 28px auto 0;
        font-size: 13.5px;
        line-height: 1.5;
        text-align: center;
        color: #8a837b;
      }
    </style>
  </body>
</html>
