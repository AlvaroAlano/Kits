---
// Tratamentos em acordeão: cada linha abre com indicação, sessões, duração e investimento.
// Usa <details> nativo (funciona sem JavaScript) e só deixa um aberto por vez.
import Icone from '../comum/Icone.astro';
import { fmt, preco } from '../../lib/texto.js';

const { site } = Astro.props;
const t = site.textos.servicos;
let numero = 0;
---

<section class="acd secao" id="tratamentos">
  <div class="container">
    <div class="acd__topo">
      <div>
        <p class="sobrelinha" data-revelar>{t.sobrelinha}</p>
        <h2 class="titulo titulo--2 acd__titulo" data-revelar style="--atraso:100ms" set:html={fmt(t.titulo)} />
      </div>
      <p class="texto" data-revelar style="--atraso:200ms">{t.texto}</p>
    </div>

    {
      site.servicos.map((grupo) => (
        <div class="acd__grupo" data-revelar>
          <h3 class="acd__categoria">
            {grupo.categoria}
            <span>{String(grupo.itens.length).padStart(2, '0')}</span>
          </h3>
          {grupo.itens.map((item) => {
            numero += 1;
            const p = preco(item);
            const valor = `${p.aPartirDe ? `${t.aPartirDe} ` : ''}${p.valor}`;
            return (
              <details class="ac" name="tratamentos" open={numero === 1}>
                <summary>
                  <span class="ac__num">{String(numero).padStart(2, '0')}</span>
                  <span class="ac__nome">{item.nome}</span>
                  <span class="ac__meta">
                    {item.duracao && <span>{item.duracao}</span>}
                    <span class="ac__preco">{valor}</span>
                  </span>
                  <span class="ac__icone" aria-hidden="true" />
                </summary>
                <div class="ac__corpo">
                  <p class="ac__desc">{item.descricao}</p>
                  <dl class="ac__ficha">
                    {item.indicado && (
                      <div>
                        <dt>{t.indicado}</dt>
                        <dd>{item.indicado}</dd>
                      </div>
                    )}
                    {item.sessoes && (
                      <div>
                        <dt>{t.sessoes}</dt>
                        <dd>{item.sessoes}</dd>
                      </div>
                    )}
                    {item.duracao && (
                      <div>
                        <dt>{t.duracao}</dt>
                        <dd>{item.duracao}</dd>
                      </div>
                    )}
                    <div>
                      <dt>{t.investimento}</dt>
                      <dd>{valor}</dd>
                    </div>
                  </dl>
                  <a class="botao" href={site.links.servico(item.nome)} target="_blank" rel="noopener">
                    <Icone nome="whatsapp" /> {t.agendar}
                  </a>
                </div>
              </details>
            );
          })}
        </div>
      ))
    }
  </div>
</section>

<style>
  .acd__topo {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--colunas-gap);
    align-items: end;
  }

  .acd__topo > div {
    grid-column: 1 / span 7;
  }

  .acd__topo > .texto {
    grid-column: 9 / -1;
  }

  .acd__titulo {
    margin-top: 24px;
  }

  .acd__grupo {
    margin-top: clamp(56px, 6vw, 88px);
  }

  .acd__categoria {
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    font-family: var(--fonte-rotulo);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .ac {
    border-top: 1px solid var(--linha-forte);
    interpolate-size: allow-keywords;
  }

  .acd__grupo .ac:last-child {
    border-bottom: 1px solid var(--linha-forte);
  }

  .ac summary {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto 44px;
    align-items: center;
    gap: 20px;
    padding-block: 22px;
    cursor: pointer;
    list-style: none;
  }

  .ac summary::-webkit-details-marker {
    display: none;
  }

  .ac__num {
    font-family: var(--fonte-rotulo);
    font-size: 12px;
    color: var(--tinta-suave);
  }

  .ac__nome {
    font-family: var(--fonte-titulo);
    font-size: clamp(1.55rem, 2.3vw, 2.1rem);
    line-height: 1.1;
    transition: color 0.3s;
  }

  /* Colunas fixas em fonte mono: duração e preço ficam alinhados de uma linha para outra */
  .ac__meta {
    display: grid;
    grid-template-columns: 8ch 21ch;
    gap: 20px;
    font-family: var(--fonte-rotulo);
    font-size: 13px;
    color: var(--tinta-suave);
    white-space: nowrap;
  }

  .ac__preco {
    grid-column: 2;
    text-align: right;
    color: var(--tinta);
  }

  .ac__icone {
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid var(--linha-forte);
    border-radius: 50%;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .ac__icone::before,
  .ac__icone::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1.5px;
    background: var(--tinta);
    transform: translate(-50%, -50%);
    transition: background-color 0.3s;
  }

  .ac__icone::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .ac[open] .ac__icone {
    background: var(--tinta);
    border-color: var(--tinta);
    transform: rotate(45deg);
  }

  .ac[open] .ac__icone::before,
  .ac[open] .ac__icone::after {
    background: var(--fundo);
  }

  @media (hover: hover) {
    .ac summary:hover .ac__nome {
      color: var(--destaque);
    }
  }

  /* Abre com animação onde o navegador suporta; nos outros, abre direto */
  .ac::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      content-visibility 0.45s allow-discrete;
  }

  .ac[open]::details-content {
    block-size: auto;
  }

  .ac__corpo {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 20px;
    row-gap: 24px;
    padding-bottom: 32px;
  }

  .ac__desc {
    grid-column: 2;
    max-width: 44ch;
    font-size: 16px;
    line-height: 1.7;
    color: var(--tinta-suave);
  }

  .ac__ficha {
    grid-column: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
    margin: 0;
  }

  .ac__ficha dt {
    font-family: var(--fonte-rotulo);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .ac__ficha dd {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .ac__corpo .botao {
    grid-column: 2;
    justify-self: start;
  }

  @media (max-width: 899px) {
    .acd__topo {
      display: block;
    }

    .acd__topo > .texto {
      margin-top: 20px;
    }

    .ac summary {
      grid-template-columns: 34px minmax(0, 1fr) 40px;
      grid-template-areas:
        'num nome icone'
        '. meta icone';
      row-gap: 8px;
      column-gap: 12px;
      padding-block: 20px;
    }

    .ac__num {
      grid-area: num;
      align-self: start;
      padding-top: 6px;
    }

    .ac__nome {
      grid-area: nome;
    }

    .ac__meta {
      grid-area: meta;
      display: flex;
      gap: 16px;
      font-size: 12px;
    }

    .ac__preco {
      text-align: left;
    }

    .ac__icone {
      grid-area: icone;
      width: 40px;
      height: 40px;
    }

    .ac__corpo {
      grid-template-columns: 1fr;
      padding: 0 0 28px 46px;
    }

    .ac__desc,
    .ac__ficha,
    .ac__corpo .botao {
      grid-column: 1;
    }

    .ac__corpo .botao {
      justify-self: stretch;
    }
  }
</style>
