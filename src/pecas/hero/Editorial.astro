---
// Topo "editorial": foto grande à esquerda e um painel de texto que avança sobre ela.
// No celular a foto ocupa a largura toda e o painel sobe por cima da parte de baixo.
import Foto from '../comum/Foto.astro';
import Icone from '../comum/Icone.astro';
import { fmt } from '../../lib/texto.js';

const { site } = Astro.props;
const t = site.textos.hero;
---

<section class="hero" id="topo">
  <div class="hero__grade container">
    <Foto
      class="hero__foto"
      foto={site.fotos.hero}
      moldura="esquerda"
      prioridade
      sizes="(min-width: 900px) 58vw, 100vw"
    />

    <div class="hero__painel">
      <p class="sobrelinha" data-revelar>{t.sobrelinha}</p>
      <h1 class="titulo titulo--1 hero__titulo" data-revelar style="--atraso:120ms" set:html={fmt(t.titulo)} />
      <p class="texto hero__texto" data-revelar style="--atraso:240ms">{t.texto}</p>
      <div class="hero__acoes" data-revelar style="--atraso:360ms">
        <a class="botao" href={site.links.agendar} target="_blank" rel="noopener">{t.cta}</a>
        <a class="link-seta" href="#tratamentos">{t.ctaSecundario} <Icone nome="seta" /></a>
      </div>
    </div>
  </div>

  <div class="container">
    <ul class="hero__fatos" data-revelar style="--atraso:480ms">
      {t.fatos.map((fato) => <li>{fato}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--altura-cab) + clamp(8px, 2vw, 32px));
  }

  .hero__grade {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--colunas-gap);
    align-items: end;
  }

  .hero__foto {
    --moldura-x: 22px;
    --moldura-y: 22px;
    grid-column: 1 / span 7;
    grid-row: 1;
    height: min(80svh, 840px);
    min-height: 540px;
  }

  .hero__painel {
    grid-column: 7 / -1;
    grid-row: 1;
    position: relative;
    z-index: 2;
    margin-bottom: clamp(40px, 9vh, 104px);
    padding: clamp(36px, 4vw, 64px) 0 clamp(36px, 4vw, 60px) clamp(32px, 4.2vw, 68px);
    background: var(--fundo);
  }

  .hero__titulo {
    margin-top: 28px;
  }

  .hero__texto {
    margin-top: 28px;
    max-width: 40ch;
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
    margin-top: 40px;
  }

  .hero__fatos {
    display: flex;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 22px;
    border-top: 1px solid var(--linha);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__foto :global(.foto__recorte) {
      animation: hero-revelar 1.5s cubic-bezier(0.7, 0, 0.2, 1) both;
    }

    .hero__foto :global(img) {
      animation: hero-aproximar 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero__foto::before {
      animation: hero-moldura 1s ease 1.1s both;
    }
  }

  @keyframes hero-revelar {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes hero-aproximar {
    from {
      transform: scale(1.14);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-moldura {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 899px) {
    .hero {
      padding-top: var(--altura-cab);
    }

    .hero__grade {
      display: block;
      padding-inline: 0;
    }

    .hero__foto {
      height: 62svh;
      min-height: 380px;
      max-height: 600px;
    }

    .hero__foto::before {
      display: none;
    }

    .hero__painel {
      margin: -96px var(--margem) 0 0;
      padding: 30px var(--margem) 0;
    }

    .hero__titulo {
      margin-top: 22px;
    }

    .hero__texto {
      margin-top: 20px;
    }

    .hero__acoes {
      margin-top: 32px;
    }

    .hero__acoes .botao {
      flex: 1 1 100%;
      max-width: 420px;
    }

    .hero__fatos {
      flex-direction: column;
      gap: 12px;
      margin-top: 48px;
      font-size: 10px;
    }
  }
</style>
